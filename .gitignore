# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - NEVER commit (local, production, or any variant)
.env
.env.local
.env.*.local
.env.production.local
.env.development.local
.env.test.local

# vercel
.vercel

# IDE & OS
.vscode/
.idea/
.DS_Store
*.swp
*.swo
*~

# Secrets
.env.*.secret
secrets/
credentials.json

# typescript
*.tsbuildinfo
next-env.d.ts
